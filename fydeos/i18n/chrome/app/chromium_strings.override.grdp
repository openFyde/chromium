<?xml version="1.0" encoding="utf-8"?>
<!-- override chrome/app/chromium_strings.grd -->
<grit-part>
  <if expr="chromeos_ash">
    <if expr="openfyde">
      <message name="IDS_PRODUCT_OS_NAME" desc="The Chrome OS application name">
        openFyde
      </message>
      <message name="IDS_SHORT_PRODUCT_OS_NAME" desc="The Chrome OS application short name">
        openFyde
      </message>
      <message name="IDS_INSTALLED_PRODUCT_OS_NAME" desc="Installed OS name">
        openFyde
      </message>
    </if>
    <if expr="not openfyde">
      <message name="IDS_PRODUCT_OS_NAME" desc="The Chrome OS application name">
        FydeOS
      </message>
      <message name="IDS_SHORT_PRODUCT_OS_NAME" desc="The Chrome OS application short name">
        FydeOS
      </message>
      <message name="IDS_INSTALLED_PRODUCT_OS_NAME" desc="Installed OS name">
        FydeOS
      </message>
    </if>
  </if>
  <message name="IDS_SESSION_CRASHED_VIEW_UMA_OPTIN" desc="Text besides the checkbox to let users optin to UMA in the restore from previous crash bubble.">
    Help make Chromium better by sending crash reports and <ph name="UMA_LINK">$1<ex>usage statistics</ex></ph> to Fyde Innovations
  </message>
  <message name="IDS_ABOUT_VERSION_COMPANY_NAME" desc="Company name on the about pages">
    Fyde Innovations, The Chromium Authors
  </message>
  <message name="IDS_ABOUT_VERSION_COPYRIGHT" desc="Copyright information on the about pages">
    Copyright <ph name="YEAR">{0,date,y}<ex>2016</ex></ph> Fyde Innovations, The Chromium Authors. All rights reserved.
  </message>
  <if expr="chromeos_ash">
    <!-- Strings for the OOBE user selection screen -->
    <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_TITLE" desc="Title of the screen which allows users to select account type.">
        Which online account would you like to use?
    </message>
    <if expr="not openfyde">
      <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_SUBTITLE" desc="Subtitle of the screen which allows users to select account type.">
          Please choose your preferred online account type to sign in to FydeOS. Please note that once signed in you won’t be able to change account type; you can however sign in new accounts of different types.
      </message>
    </if>
    <if expr="openfyde">
      <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_SUBTITLE" desc="Subtitle of the screen which allows users to select account type.">
          Please choose your preferred online account type to sign in to openFyde. Please note that once signed in you won’t be able to change account type; you can however sign in new accounts of different types.
      </message>
    </if>
    <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_FYDEOS_TITLE" desc="Title of user select FydeOS account type.">
        FydeOS account
    </message>
    <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_FYDEOS_SUBTITLE" desc="Subtitle of user select FydeOS account type.">
        Sign in with a FydeOS account and use cloud services associated by your FydeOS account.
    </message>
    <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_GOOGLE_TITLE" desc="Title of user select Google account type.">
        Google account
    </message>
    <message name="IDS_OOBE_ACCOUNT_TYPE_SELECTION_GOOGLE_SUBTITLE" desc="Subtitle of user select Google account type.">
        Sign in with a Google account and use cloud services provided by Google.
    </message>
    <if expr="openfyde">
      <message name="IDS_ABOUT_CROS_VERSION_LICENSE" desc="Additional text displayed beneath the Chromium open source URLs for Chrome OS.">
        openFyde is made possible by additional <ph name="BEGIN_LINK_CROS_OSS">&lt;a target="_blank" href="$1"&gt;</ph>open source software<ph name="END_LINK_CROS_OSS">&lt;/a&gt;</ph>.
      </message>
      <message name="IDS_ABOUT_CROS_WITH_LINUX_VERSION_LICENSE" desc="Additional text displayed beneath the Chromium open source URLs for Chrome OS when Crostini is installed.">
        openFyde is made possible by additional <ph name="BEGIN_LINK_CROS_OSS">&lt;a target="_blank" href="$1"&gt;</ph>open source software<ph name="END_LINK_CROS_OSS">&lt;/a&gt;</ph>, as is <ph name="BEGIN_LINK_LINUX_OSS">&lt;a target="_blank" href="$2"&gt;</ph>Linux (Beta)<ph name="END_LINK_LINUX_OSS">&lt;/a&gt;</ph>.
      </message>
      <message name="IDS_EXTERNAL_PROTOCOL_NO_HANDLER_TITLE" desc="External Protocol Dialog Title">
        openFyde can't open this page.
      </message>
      <message name="IDS_SYNC_SIGN_IN_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when the user's sign-in credentials are out of date.">
        openFyde could not sync your data because your account sign-in details are out of date.
      </message>
      <message name="IDS_SYNC_UNAVAILABLE_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when sync is not available for their domain.">
        openFyde could not sync your data because Sync is not available for your domain.
      </message>
      <message name="IDS_SYNC_OTHER_SIGN_IN_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when there's an error signing in.">
        openFyde could not sync your data due to an error signing in.
      </message>
      <message name="IDS_UPDATE_RECOMMENDED_DIALOG_TITLE" desc="The window title for the Update Recommended dialog.">
        Restart openFyde
      </message>
      <message name="IDS_UPDATE_RECOMMENDED" desc="The main text of the Update Recommended dialog.">
        openFyde needs to be restarted to apply the update.
      </message>
      <message name="IDS_INSTALLING_UPDATE" desc="Label shown on the updates installation screen during OOBE">
        Please wait while openFyde installs the latest system updates.
      </message>
      <message name="IDS_EULA_SCREEN_ACCESSIBLE_TITLE" desc="Title to be spoken on opening the OOBE EULA screen">
        openFyde terms
      </message>
      <message name="IDS_EULA_CHECKBOX_ENABLE_LOGGING" desc="The label of the checkbox to enable/disable crash and user metrics logging">
        Optional: Help make openFyde better by automatically sending usage statistics and crash reports to Fyde Innovations.
      </message>
      <message name="IDS_TERMS_OF_SERVICE_SCREEN_SUBHEADING" desc="Subheading at the top of the Terms of Service screen.">
        <ph name="DOMAIN">$1<ex>example.com</ex></ph> requires that you read and accept the following Terms of Service before using this device. These terms do not expand, modify or limit the openFyde EULA Terms.
      </message>
      <message name="IDS_RESTORE_NOTIFICATION_DISPLAY_SOURCE" desc="This is the string shown as the display source of the notification for the user to select restore or not on startup.">
        openFyde
      </message>
    </if>
    <if expr="not openfyde">
      <message name="IDS_ABOUT_CROS_VERSION_LICENSE" desc="Additional text displayed beneath the Chromium open source URLs for Chrome OS.">
        FydeOS is made possible by additional <ph name="BEGIN_LINK_CROS_OSS">&lt;a target="_blank" href="$1"&gt;</ph>open source software<ph name="END_LINK_CROS_OSS">&lt;/a&gt;</ph>.
      </message>
      <message name="IDS_ABOUT_CROS_WITH_LINUX_VERSION_LICENSE" desc="Additional text displayed beneath the Chromium open source URLs for Chrome OS when Crostini is installed.">
        FydeOS is made possible by additional <ph name="BEGIN_LINK_CROS_OSS">&lt;a target="_blank" href="$1"&gt;</ph>open source software<ph name="END_LINK_CROS_OSS">&lt;/a&gt;</ph>, as is <ph name="BEGIN_LINK_LINUX_OSS">&lt;a target="_blank" href="$2"&gt;</ph>Linux (Beta)<ph name="END_LINK_LINUX_OSS">&lt;/a&gt;</ph>.
      </message>
      <message name="IDS_EXTERNAL_PROTOCOL_NO_HANDLER_TITLE" desc="External Protocol Dialog Title">
        FydeOS can't open this page.
      </message>
      <message name="IDS_SYNC_SIGN_IN_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when the user's sign-in credentials are out of date.">
        FydeOS could not sync your data because your account sign-in details are out of date.
      </message>
      <message name="IDS_SYNC_UNAVAILABLE_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when sync is not available for their domain.">
        FydeOS could not sync your data because Sync is not available for your domain.
      </message>
      <message name="IDS_SYNC_OTHER_SIGN_IN_ERROR_BUBBLE_VIEW_MESSAGE" desc="Message in the sign-in error notification when there's an error signing in.">
        FydeOS could not sync your data due to an error signing in.
      </message>
      <message name="IDS_UPDATE_RECOMMENDED_DIALOG_TITLE" desc="The window title for the Update Recommended dialog.">
        Restart FydeOS
      </message>
      <message name="IDS_UPDATE_RECOMMENDED" desc="The main text of the Update Recommended dialog.">
        FydeOS needs to be restarted to apply the update.
      </message>
      <message name="IDS_INSTALLING_UPDATE" desc="Label shown on the updates installation screen during OOBE">
        Please wait while FydeOS installs the latest system updates.
      </message>
      <message name="IDS_EULA_SCREEN_ACCESSIBLE_TITLE" desc="Title to be spoken on opening the OOBE EULA screen">
        FydeOS terms
      </message>
      <message name="IDS_EULA_CHECKBOX_ENABLE_LOGGING" desc="The label of the checkbox to enable/disable crash and user metrics logging">
        Optional: Help make FydeOS better by automatically sending usage statistics and crash reports to Fyde Innovations.
      </message>
      <message name="IDS_TERMS_OF_SERVICE_SCREEN_SUBHEADING" desc="Subheading at the top of the Terms of Service screen.">
        <ph name="DOMAIN">$1<ex>example.com</ex></ph> requires that you read and accept the following Terms of Service before using this device. These terms do not expand, modify or limit the FydeOS EULA Terms.
      </message>
      <message name="IDS_RESTORE_NOTIFICATION_DISPLAY_SOURCE" desc="This is the string shown as the display source of the notification for the user to select restore or not on startup.">
        FydeOS
      </message>
    </if>
  </if>
</grit-part>
