<?xml version="1.0" encoding="utf-8"?>
<!-- override chrome/app/nearby_share_strings.grdp, included from generated_resources.grd -->
<grit-part>

  <message name="IDS_SETTINGS_NEARBY_SHARE_DESCRIPTION" desc="A description of nearby share that helps users understand what the feature is used for.">
    Share files with people around you
  </message>
  <message name="IDS_NEARBY_CONTACT_VISIBILITY_ZERO_STATE_TEXT" desc="Zero state help text to explain how the visibility settings control the Nearby Share feature.">
    Your device visibility controls who can share with you while your screen is unlocked.
  </message>
  <if expr="openfyde">
    <message name="IDS_NEARBY_ONBOARDING_PAGE_SUBTITLE" desc="Subtitle of the Nearby Share onboarding page that sets up the local device for the feature which provides a way for nearby devices to share files, text, and urls.">
      Share files with openFyde devices and Android devices around you
    </message>
    <message name="IDS_NEARBY_DISCOVERY_PAGE_INFO" desc="Help text on how to use the Nearby Share feature. Explains how to enable it on a nearby Chromebook to share with it.">
      Make sure both devices are unlocked, close together, and have Bluetooth turned on. If you’re sharing with a openFyde device not in your contacts, make sure it has Nearby visibility turned on (open the status area, then turn on Nearby visibility).
    </message>
    <message name="IDS_NEARBY_SETTINGS_HELP_CAPTION" desc="Brief explanation shown at the bottom of the settings page. Meant to give context on what conditions have to be met to use Nearby Share, and how to toggle the high visibility state in the system tray. Provides a link with more detailed information.">
      To use Nearby Share, make sure both devices are unlocked, close together, and have Bluetooth turned on. If you’re sharing with a openFyde device that is not in your contacts, make sure it has Nearby visibility turned on (open the status area by selecting the time, then turn on Nearby visibility).
    </message>
  </if>
  <if expr="not openfyde">
    <message name="IDS_NEARBY_ONBOARDING_PAGE_SUBTITLE" desc="Subtitle of the Nearby Share onboarding page that sets up the local device for the feature which provides a way for nearby devices to share files, text, and urls.">
      Share files with FydeOS devices and Android devices around you
    </message>
    <message name="IDS_NEARBY_DISCOVERY_PAGE_INFO" desc="Help text on how to use the Nearby Share feature. Explains how to enable it on a nearby Chromebook to share with it.">
      Make sure both devices are unlocked, close together, and have Bluetooth turned on. If you’re sharing with a FydeOS device not in your contacts, make sure it has Nearby visibility turned on (open the status area, then turn on Nearby visibility).
    </message>
    <message name="IDS_NEARBY_SETTINGS_HELP_CAPTION" desc="Brief explanation shown at the bottom of the settings page. Meant to give context on what conditions have to be met to use Nearby Share, and how to toggle the high visibility state in the system tray. Provides a link with more detailed information.">
      To use Nearby Share, make sure both devices are unlocked, close together, and have Bluetooth turned on. If you’re sharing with a FydeOS device that is not in your contacts, make sure it has Nearby visibility turned on (open the status area by selecting the time, then turn on Nearby visibility).
    </message>
  </if>

</grit-part>
