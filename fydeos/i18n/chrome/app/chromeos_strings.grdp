<?xml version="1.0" encoding="utf-8"?>
<grit-part>
  <message name="IDS_FYDEOS_LOCAL_SIGNUP_TITLE" desc="Title of oobe fydeos local signin page">
    Create your local openFyde account
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_TITLE" desc="Title of oobe fydeos local signin page">
    Sign in your local openFyde account
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_USERNAME" desc="Label of oobe fydeos local signin page, username input">
    Username
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_INVALID_USERNAME" desc="Error message of oobe fydeos local signin page, username input">
    Invalid username
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_PASSWORD" desc="Label of oobe fydeos local signin page, password input">
    Password
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_INVALID_PASSWORD" desc="Error message of oobe fydeos local signin page, password input">
    Please input a password
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_PASSWORD_CONFIRM" desc="Label of oobe fydeos local signin page, password_confirm input">
    Confirm password
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_PASSWORD_CONFIRM_ERROR" desc="Error message of oobe fydeos local signin page, password_confirm input">
    Your passwords do not match
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_NEW_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe fydeos local signin page, password_confirm input">
    Create a new local account
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_BUTTON_TEXT" desc="Error message of oobe fydeos local signin page, password_confirm input">
    Sign in to an existing account
  </message>
  <message name="IDS_FYDEOS_LOCAL_SIGNIN_EXIST_LOCAL_ACCOUNT_ERROR_MESSAGE" desc="Error message of oobe fydeos local signin page, password_confirm input">
    The username or password you entered is incorrect
  </message>
  <message name="IDS_FYDE_LOCAL_SIGNIN_HTML" desc="Text shown on network error screen, suggest user to use fyde local account">
    You can <ph name="LINK_START">$1<ex>&gt;a&lt;</ex></ph>sign in with a FydeOS local account<ph name="LINK_END">$2<ex>&gt;/a&lt;</ex></ph>.
  </message>
  <message name="IDS_FYDEOS_ADD_USER_DUP_EMAIL_ERROR_MESSAGE" desc="error message when user want to add existed email with different account type (fydeos or google)">
    Email <ph name="EMAIL_ADDRESS">$1</ph> already exists. Please retry with another email.
  </message>
  <message name="IDS_FYDEOS_USE_LOCAL_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
    Use local account
  </message>
  <message name="IDS_FYDEOS_USE_ONLINE_ACCOUNT_BUTTON_TEXT" desc="text on button of modal dialog in gaia_signin screen">
    Continue to use online account
  </message>
  <message name="IDS_FYDEOS_CONFIRM_GOTO_LOCAL_ACCOUNT_TITLE" desc="title of modal dialog in gaia_signin screen">
    Switch to local account?
  </message>
  <message name="IDS_FYDEOS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_1" desc="first hint message of modal dialog in gaia_signin screen">
    If you opt to use a local account, useful features include synchronising your data and preferences across multiple FydeOS devices and automatically signing in web apps using your FydeOS account will not work.
  </message>
  <message name="IDS_FYDEOS_CONFIRM_GOTO_LOCAL_HINT_MESSAGE_2" desc="first hint message of modal dialog in gaia_signin screen">
    We recommend using an online account to utilise FydeOS to its fullest.
  </message>
  <message name="IDS_LOGIN_GOOGLE_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
    You will not be able to add Google accounts because Google API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.
  </message>
  <message name="IDS_LOGIN_FYDE_API_KEYS_NOTICE" desc="Notice displayed on the login screen in case if API keys are missing.">
    You will not be able to add FydeOS accounts because FydeOS API keys are missing. See <ph name="DETAILS_URL">$1<ex>http://www.example.com</ex></ph> for details.
  </message>
</grit-part>
