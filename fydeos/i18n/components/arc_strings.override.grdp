<?xml version="1.0" encoding="utf-8"?>
<!-- override components/arc_strings.grdp, included from components/components_strings.grd -->
<grit-part>
  <message name="IDS_ASH_ARC_NEARBY_SHARE_ERROR_DIALOG_MESSAGE" desc="Dialog body that tells the user there was an error while sharing text and/or files.">
    Something went wrong while using Quick Share
  </message>
  <message name="IDS_ASH_ARC_NEARBY_SHARE_LOW_DISK_SPACE_DIALOG_MESSAGE" desc="Dialog body that tells the user Nearby Share failed due to low disk space while sharing a file(s).">
    {NUM_FILES, plural,
      =1 {To send this file using Quick Share, free up space (<ph name="DISK_SPACE_SIZE">$1<ex>20MB</ex></ph>) on your device}
      other {To send these files using Quick Share, free up space (<ph name="DISK_SPACE_SIZE">$1<ex>20MB</ex></ph>) on your device}}
  </message>
</grit-part>
