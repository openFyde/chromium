import("//build/config/chromeos/rules.gni")

assert(is_chromeos, "Non-Chrome-OS builds must not depend on //chromeos")

component("fydeos_shell_client") {
  output_name = "ash_fydeos_shell_client"
  defines = [ "IS_ASH_DBUS_FYDEOS_SHELL_CLIENT_IMPL" ]
  deps = [
    "//base",
    "//chromeos/dbus/common",
    "//chromeos/dbus/constants",
    "//dbus",
  ]
  sources = [
    "fydeos_shell_client.cc",
    "fydeos_shell_client.h",
    "shell_state.cc",
    "shell_state.h",
  ]
}
